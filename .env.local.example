# --- 데이터베이스 (Neon Postgres 권장) ---
# https://neon.tech 에서 프로젝트 생성 → Pooled connection string 복사
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- NextAuth ---
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="여기에_랜덤_문자열"
# 프로덕션에서는 실제 도메인. 로컬은 비워두면 됩니다.
# AUTH_URL="https://tbm.example.com"

# --- 사진 저장소 ---
# Vercel 대시보드 → Storage → Blob 생성 시 자동 주입됩니다.
# 값이 없으면 로컬 public/uploads 폴더에 저장됩니다(개발용).
BLOB_READ_WRITE_TOKEN=""

# --- QR 체크인 링크에 사용할 공개 주소 ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- 주소 → 좌표 변환 (선택) ---
# 비워 두면 OpenStreetMap을 씁니다. 키 없이 동작하지만 국내 주소 적중률이 낮습니다.
# https://developers.kakao.com 앱 생성 → 앱 키 → REST API 키
# 카카오 키를 넣으면 도로명·지번 주소는 물론 공장 이름으로도 찾을 수 있습니다.
KAKAO_REST_API_KEY=""
