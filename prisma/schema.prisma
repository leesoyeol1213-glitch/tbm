// TBM(Tool Box Meeting) 일일 안전점검회의 기록·결재 시스템
// 본사 + 다수 사업장 구조, 1단계 결재(팀장 작성 → 안전관리자 승인)
//
// 운영 시나리오
//   1) 작업자가 출근하며 지문인식기 옆 고정 QR을 스캔 → 본인 확인 → 출석 기록
//   2) 그날 첫 체크인 시 해당 팀의 TBM이 자동 생성되고, 템플릿(매일 동일한 교육 내용
//      + 상시 위험요인)이 스냅샷으로 복사된다
//   3) 팀장은 현장 사진을 올리고 필요한 부분만 손질해 상신
//   4) 안전관리자가 승인 또는 반려

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  HQ_ADMIN // 본사 관리자: 전 사업장 조회, 마스터 관리
  SITE_MANAGER // 사업장 안전관리자: 소속 사업장 TBM 작성, 담당 공장 순찰일지 작성
  CEO // 법인 대표: 소속 법인 TBM 승인 (TBM 결재선의 유일한 승인자)
  SAFETY_DIRECTOR // 안전실장: 순찰일지 1차 결재. 법인이 아니라 회사 전체를 본다.
  DIVISION_HEAD // 본부장: 순찰일지 최종 결재
  TEAM_LEAD // 작업팀장: 소속 팀 TBM 작성
}

enum TbmStatus {
  DRAFT // 작성중
  SUBMITTED // 상신(결재 대기)
  APPROVED // 승인
  REJECTED // 반려
}

enum AttendanceState {
  PRESENT // 참석
  ABSENT // 불참
  LATE // 지각
}

enum AttendanceMethod {
  QR // 작업자가 고정 QR을 스캔해 본인 체크인
  MANUAL // 팀장이 명단에서 직접 체크
}

/// 사업부. 법인(사업장) 위의 조직 단위.
///
/// 외국인 고용을 위해 법인을 쪼개 놓은 탓에 법인 열 개가 실제로는 한 사업부다.
/// 안전실장·본부장처럼 법인이 아니라 사업부를 맡는 자리가 있어 따로 둔다.
model Division {
  id     String  @id @default(cuid())
  name   String  @unique /// 예: 가공사업부
  active Boolean @default(true)
  sort   Int     @default(0)

  createdAt DateTime @default(now())

  sites  Site[]
  plants Plant[]
  users  User[]
}

/// 사업장(현장). 본사 소속 사용자는 siteId가 null이며 전 사업장을 조회한다.
model Site {
  id         String  @id @default(cuid())
  code       String  @unique /// 사업장 코드 (예: A01)
  name       String
  divisionId String?
  address    String?

  /// 지오펜스 기준 좌표. 사진 GPS와 대조해 현장 이탈 작성을 탐지한다.
  lat       Float?
  lng       Float?
  /// 허용 반경(m). 이 밖에서 찍힌 사진은 경고 플래그가 붙는다.
  geofenceM Int    @default(500)

  /// TBM 제출 마감 시각(자정 기준 분). 기본 08:30 = 510
  dueMinute       Int @default(510)
  /// 출석 체크인 허용 시작 시각. 기본 06:00 = 360
  checkinFrom     Int @default(360)
  /// 출석 체크인 마감 시각. 기본 10:00 = 600
  checkinUntil    Int @default(600)
  /// 이 시각 이후 체크인은 LATE로 기록. 기본 08:30 = 510
  lateAfterMinute Int @default(510)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  division  Division?          @relation(fields: [divisionId], references: [id])
  users     User[]
  teams     Team[]
  workers   Worker[]
  tbms      Tbm[]
  points    CheckinPoint[]     @relation("PointOwner")
  coveredBy CheckinPointSite[] @relation("PointCoverage")
  templates TbmTemplate[]
}

model User {
  id           String   @id @default(cuid())
  /// 로그인 아이디. 이메일이 아니어도 된다 — 이름을 그대로 써도 되고,
  /// 동명이인이 생기면 아이디만 구분해 준다(예: 김안전.음성). 이름은 문서에 찍히는
  /// 값이라 별개로 둔다.
  username     String   @unique
  name         String
  passwordHash String
  role         Role     @default(TEAM_LEAD)
  /// HQ_ADMIN·안전실장·본부장은 null
  siteId       String?
  /// 법인이 아니라 사업부를 맡는 자리(안전실장·본부장)의 소속
  divisionId   String?
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  site               Site?      @relation(fields: [siteId], references: [id])
  division           Division?  @relation(fields: [divisionId], references: [id])
  ledTeams           Team[]     @relation("TeamLeader")
  authoredTbms       Tbm[]      @relation("TbmAuthor")
  approvedTbms       Tbm[]      @relation("TbmApprover")
  /// 본사가 이 사람을 대신해 대결한 건들
  delegatedTbms      Tbm[]      @relation("TbmDelegatedFor")
  managedPlants      Plant[]    @relation("PlantManager")
  authoredPatrols    Patrol[]   @relation("PatrolAuthor")
  approvedPatrols    Patrol[]   @relation("PatrolApprover")
  delegatedPatrols   Patrol[]   @relation("PatrolDelegatedFor")
  paperSignedTbms    Tbm[]      @relation("TbmPaperSigner")
  paperSignedPatrols Patrol[]   @relation("PatrolPaperSigner")
  auditLogs          AuditLog[]

  @@index([siteId])
}

/// 작업팀(공종). TBM은 팀 단위로 하루 한 건 작성된다.
model Team {
  id       String  @id @default(cuid())
  siteId   String
  name     String
  /// 소속 협력업체명
  company  String?
  leaderId String?
  active   Boolean @default(true)

  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  leader  User?    @relation("TeamLeader", fields: [leaderId], references: [id])
  workers Worker[]
  tbms    Tbm[]

  @@unique([siteId, name])
  @@index([siteId])
}

/// 작업자 명부. 로그인 계정 없이 QR 체크인 대상으로만 존재한다.
model Worker {
  id        String  @id @default(cuid())
  siteId    String
  teamId    String?
  name      String
  /// 사번. QR 체크인 시 동명이인 구분에 쓴다.
  empNo     String?
  /// 직종 (예: 조립, 포장, 전기)
  jobTitle  String?
  /// 휴대폰. 연락용이며 본인 확인에는 쓰지 않는다. 자주 바뀌기 때문이다.
  phone     String?
  /// 생년월일 중 월일 네 자리(MMDD). QR 자가 등록 때 본인 확인에 쓴다.
  /// 연도는 받지 않는다 — 확인에 필요 없고 보관할 개인정보를 줄이기 위해서다.
  birthMmdd String?
  company   String?
  active    Boolean @default(true)

  createdAt DateTime @default(now())

  site        Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  team        Team?           @relation(fields: [teamId], references: [id])
  attendances TbmAttendance[]

  @@unique([siteId, empNo])
  @@index([siteId])
  @@index([teamId])
}

/// 출석 QR을 인쇄해 부착하는 지점 (예: "진천 정문 지문인식기").
/// 토큰은 고정이라 한 번 인쇄하면 계속 쓴다.
///
/// 한 물리적 장소에 여러 법인이 들어가 지문인식기를 공용으로 쓰는 경우가 있어,
/// QR 하나가 여러 사업장의 명부를 함께 받을 수 있다(coverage).
/// siteId는 이 QR을 만들고 관리하는 주체이며, 항상 coverage에 포함된다.
model CheckinPoint {
  id     String  @id @default(cuid())
  siteId String
  name   String
  token  String  @unique @default(cuid())
  active Boolean @default(true)

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  site     Site               @relation("PointOwner", fields: [siteId], references: [id], onDelete: Cascade)
  coverage CheckinPointSite[]

  @@index([siteId])
}

/// 이 QR이 출석을 받아 주는 사업장 목록.
model CheckinPointSite {
  pointId String
  siteId  String

  point CheckinPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  site  Site         @relation("PointCoverage", fields: [siteId], references: [id], onDelete: Cascade)

  @@id([pointId, siteId])
  @@index([siteId])
}

// ---------------------------------------------------------------------------
// 템플릿: 매일 동일한 교육 내용과 상시 위험요인을 자동으로 채우기 위한 기본 양식
// ---------------------------------------------------------------------------

/// 사업장별 TBM 기본 양식. siteId가 null이면 전사 공통 양식.
model TbmTemplate {
  id              String  @id @default(cuid())
  siteId          String?
  name            String
  /// 기본 작업 내용 (공정이 단순해 매일 거의 같은 경우)
  workDescription String?
  active          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site     Site?             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  eduItems TemplateEduItem[]
  hazards  TemplateHazard[]

  @@index([siteId])
}

/// 매일 교육하는 안전보건교육 과정 항목
model TemplateEduItem {
  id         String @id @default(cuid())
  templateId String
  content    String
  sort       Int    @default(0)

  template TbmTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

/// 상시 위험요인 - 안전대책 쌍
model TemplateHazard {
  id         String @id @default(cuid())
  templateId String
  hazard     String
  control    String
  sort       Int    @default(0)

  template TbmTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

// ---------------------------------------------------------------------------
// 일일 기록
// ---------------------------------------------------------------------------

/// 일일 TBM 기록. (팀, 작업일) 조합으로 유일하다.
model Tbm {
  id              String    @id @default(cuid())
  siteId          String
  teamId          String
  /// 작업일 (KST 기준 날짜)
  workDate        DateTime  @db.Date
  /// TBM 실시 시작 시각
  heldAt          DateTime?
  /// TBM 실시 종료 시각
  heldUntil       DateTime?
  weather         String?
  /// 오늘의 작업 내용 (템플릿에서 복사되며 수정 가능)
  workDescription String    @default("")
  /// 특이사항·건의사항, 아차사고 공유 등
  remarks         String?

  status      TbmStatus @default(DRAFT)
  /// 첫 QR 체크인으로 자동 생성된 경우 작성자가 아직 없을 수 있다.
  authorId    String?
  autoCreated Boolean   @default(false)

  submittedAt  DateTime?
  approverId   String?
  approvedAt   DateTime?
  rejectReason String?
  /// 대결(代決). 본사 관리자가 법인 대표를 대신해 결재한 경우, 그 대표를 가리킨다.
  /// 실제로 누른 사람은 approverId에 그대로 남는다. 법인에 대표 계정이 없으면 null.
  onBehalfOfId String?
  /// 승인된 뒤 본사가 내용을 정정한 시각. 정정 이력은 AuditLog에 남는다.
  correctedAt  DateTime?

  /// 출력물에 최종결재자가 손으로 서명한 것을 본사가 확인한 시각.
  /// 전자결재(approvedAt)와 별개다 — 종이 원본이 어디까지 갖춰졌는지를 따로 센다.
  paperSignedAt   DateTime?
  paperSignedById String?

  /// 출석 체크인 허용 여부 (마감하면 QR 스캔이 거부된다)
  checkinOpen Boolean @default(true)

  // --- 자동 검증 플래그 (사후 작성·위조 억제용) ---
  /// 마감 시각을 넘겨 상신됨
  flagLateSubmit   Boolean @default(false)
  /// 사진 촬영일이 작업일과 다름
  flagPhotoDateGap Boolean @default(false)
  /// 사진 GPS가 사업장 반경 밖
  flagOutsideFence Boolean @default(false)
  /// 사진에 EXIF가 없음(스크린샷·재전송 의심)
  flagNoExif       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site          Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  team          Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author        User?           @relation("TbmAuthor", fields: [authorId], references: [id])
  approver      User?           @relation("TbmApprover", fields: [approverId], references: [id])
  onBehalfOf    User?           @relation("TbmDelegatedFor", fields: [onBehalfOfId], references: [id])
  paperSignedBy User?           @relation("TbmPaperSigner", fields: [paperSignedById], references: [id])
  eduItems      TbmEduItem[]
  hazards       HazardItem[]
  photos        TbmPhoto[]
  attendances   TbmAttendance[]
  logs          AuditLog[]

  @@unique([teamId, workDate])
  @@index([siteId, workDate])
  @@index([status])
}

/// 그날 실제로 교육한 항목. 템플릿에서 복사한 스냅샷이라 템플릿이 나중에 바뀌어도
/// 과거 기록은 그대로 남는다.
model TbmEduItem {
  id      String  @id @default(cuid())
  tbmId   String
  content String
  sort    Int     @default(0)
  /// 팀장이 실제 교육 완료를 체크
  done    Boolean @default(true)

  tbm Tbm @relation(fields: [tbmId], references: [id], onDelete: Cascade)

  @@index([tbmId])
}

/// 그날의 위험요인 - 안전대책 쌍
model HazardItem {
  id      String @id @default(cuid())
  tbmId   String
  hazard  String
  control String
  sort    Int    @default(0)

  tbm Tbm @relation(fields: [tbmId], references: [id], onDelete: Cascade)

  @@index([tbmId])
}

/// 현장 사진 + EXIF 검증 결과
model TbmPhoto {
  id           String   @id @default(cuid())
  tbmId        String
  url          String
  pathname     String
  uploadedById String?
  uploadedAt   DateTime @default(now())

  /// EXIF에서 추출한 촬영 시각 (KST 벽시계로 해석)
  takenAt   DateTime?
  lat       Float?
  lng       Float?
  /// 사업장 좌표로부터의 거리(m)
  distanceM Int?
  hasExif   Boolean   @default(false)
  /// 검증 경고 메시지 목록
  warnings  String[]  @default([])

  /// 같은 주소를 쓰는 법인들에 한 번에 올린 사진이면 사본끼리 같은 값을 갖는다.
  /// 한 공장에서 합동으로 TBM을 하는 경우를 위한 것이다.
  sharedGroupId String?

  tbm Tbm @relation(fields: [tbmId], references: [id], onDelete: Cascade)

  @@index([tbmId])
  @@index([sharedGroupId])
}

model TbmAttendance {
  id          String           @id @default(cuid())
  tbmId       String
  workerId    String
  state       AttendanceState  @default(PRESENT)
  method      AttendanceMethod @default(QR)
  checkedInAt DateTime         @default(now())
  /// 체크인이 일어난 QR 지점
  pointId     String?
  /// 불참 사유 등
  note        String?

  tbm    Tbm    @relation(fields: [tbmId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([tbmId, workerId])
  @@index([tbmId])
}

/// 결재·수정 이력
model AuditLog {
  id       String  @id @default(cuid())
  tbmId    String?
  patrolId String?
  actorId  String?
  /// CREATE / AUTO_CREATE / UPDATE / SUBMIT / APPROVE / REJECT / PHOTO_ADD / CHECKIN ...
  action   String
  detail   String?

  createdAt DateTime @default(now())

  tbm    Tbm?    @relation(fields: [tbmId], references: [id], onDelete: Cascade)
  patrol Patrol? @relation(fields: [patrolId], references: [id], onDelete: Cascade)
  actor  User?   @relation(fields: [actorId], references: [id])

  @@index([tbmId])
  @@index([patrolId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// 안전(순찰)일지
//
// 순찰의 단위는 법인이 아니라 공장이다. 외국인 고용을 위해 법인을 쪼개 놨을
// 뿐 공장은 하나이고, 순찰은 그 공장을 한 바퀴 도는 일이라 법인 수만큼 돌지
// 않는다. 그래서 TBM(법인 × 팀 × 날짜)과 달리 공장 × 날짜로 잡는다.
//
// 결재선도 TBM과 다르다. TBM은 그 법인 대표가 승인하지만 순찰일지는
// 작성자 → 안전실장 → 본부장 두 단계를 거친다. 둘 다 회사 전체를 보는
// 자리라 법인과 무관하다.
// ---------------------------------------------------------------------------

/// 순찰 판정. 양식의 "양호 / 불량" 칸에 해당한다.
enum PatrolState {
  GOOD // 양호
  BAD // 불량
  NA // 해당없음 — 그날 그 설비를 안 돌린 경우 빈칸 대신 쓴다
}

/// 순찰일지 결재 상태.
///
/// TbmStatus와 값이 같지만 따로 둔다. TBM은 법인 대표가, 순찰일지는 안전실장이
/// 결재하는 서로 다른 결재선이라 한쪽이 바뀔 때 다른 쪽이 끌려가면 안 된다.
enum PatrolStatus {
  DRAFT // 작성중
  SUBMITTED // 상신 — 안전실장 결재 대기
  APPROVED // 안전실장 승인 (최종)
  REJECTED // 반려
}

/// 순찰 단위가 되는 물리적 공장. 법인과 묶지 않는다.
model Plant {
  id         String  @id @default(cuid())
  name       String  @unique /// 예: 진천 1공장
  divisionId String?
  address    String?
  /// 이 공장의 순찰일지를 쓰는 사람. 비어 있으면 본사만 쓸 수 있다.
  managerId  String?
  active     Boolean @default(true)
  sort       Int     @default(0)

  createdAt DateTime @default(now())

  division  Division?        @relation(fields: [divisionId], references: [id])
  manager   User?            @relation("PlantManager", fields: [managerId], references: [id])
  patrols   Patrol[]
  templates PatrolTemplate[]

  @@index([managerId])
}

/// 공장별 순찰일지 기본 양식. plantId가 null이면 전사 공통 양식.
///
/// 점검항목뿐 아니라 매번 같은 값을 미리 담아 둔다. 순찰자도 순찰 경로도
/// 실제로는 거의 바뀌지 않는데 매일 다시 적게 하면 결국 아무도 안 적는다.
model PatrolTemplate {
  id            String  @id @default(cuid())
  plantId       String?
  name          String
  /// 기본 순찰자. 매번 같은 사람이 도는 경우가 많다.
  patrollerName String?
  active        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plant  Plant?                @relation(fields: [plantId], references: [id], onDelete: Cascade)
  items  PatrolTemplateItem[]
  rounds PatrolTemplateRound[]

  @@index([plantId])
}

/// 매번 도는 순찰 경로 (장소 + 내용). 판정은 그날 사람이 찍는다.
model PatrolTemplateRound {
  id         String @id @default(cuid())
  templateId String
  place      String
  content    String
  sort       Int    @default(0)

  template PatrolTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

/// 매번 같은 순서로 확인하는 안전점검사항 (예: 안전보호구 착용 준수여부)
model PatrolTemplateItem {
  id            String  @id @default(cuid())
  templateId    String
  content       String
  /// 매번 같은 문구가 들어가는 조치사항. "기타 유해위험 요인"의 상시 교육 내용처럼
  /// 해마다 거의 그대로인 글을 미리 담아 둔다. 그날 다르면 고쳐 쓰면 된다.
  defaultAction String?
  sort          Int     @default(0)

  template PatrolTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

/// 일일 안전(순찰)일지. (공장, 순찰일) 조합으로 유일하다.
model Patrol {
  id            String    @id @default(cuid())
  plantId       String
  /// 순찰일 (KST 기준 날짜)
  patrolDate    DateTime  @db.Date
  /// 순찰 시작·종료 시각. 양식의 "시간 8:00 ~" 칸.
  startedAt     DateTime?
  endedAt       DateTime?
  weather       String?
  /// 문서에 찍히는 순찰자 이름. 실제로 돈 사람과 입력한 계정이 다를 수 있어
  /// 작성자(authorId)와 따로 둔다.
  patrollerName String
  /// 3. 기타건의 및 특이사항
  remarks       String?

  status PatrolStatus @default(DRAFT)

  authorId    String?
  submittedAt DateTime?

  /// 결재 — 안전실장
  approverId   String?
  approvedAt   DateTime?
  /// 본사가 안전실장을 대신해 누른 경우 그 안전실장
  onBehalfOfId String?

  rejectReason String?
  /// 승인된 뒤 본사가 내용을 정정한 시각.
  correctedAt  DateTime?

  /// 출력물에 최종결재자가 손으로 서명한 것을 본사가 확인한 시각.
  /// 전자결재(approvedAt)와 별개다 — 종이 원본이 어디까지 갖춰졌는지를 따로 센다.
  paperSignedAt   DateTime?
  paperSignedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plant         Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)
  author        User? @relation("PatrolAuthor", fields: [authorId], references: [id])
  approver      User? @relation("PatrolApprover", fields: [approverId], references: [id])
  onBehalfOf    User? @relation("PatrolDelegatedFor", fields: [onBehalfOfId], references: [id])
  paperSignedBy User? @relation("PatrolPaperSigner", fields: [paperSignedById], references: [id])

  rounds PatrolRound[]
  checks PatrolCheck[]
  logs   AuditLog[]

  @@unique([plantId, patrolDate])
  @@index([plantId, patrolDate])
  @@index([status])
}

/// 1. 순찰사항 — 어디를 어떻게 돌았는지. 줄 수는 그날그날 다르다.
model PatrolRound {
  id       String      @id @default(cuid())
  patrolId String
  /// 장소 (예: 1공장 원료동)
  place    String
  /// 내용 (예: 설비별 안전순회)
  content  String
  state    PatrolState @default(GOOD)
  /// 비고
  note     String?
  sort     Int         @default(0)

  patrol Patrol @relation(fields: [patrolId], references: [id], onDelete: Cascade)

  @@index([patrolId])
}

/// 2. 안전점검사항 — 점검표에서 복사되며, 판정과 조치사항을 채운다.
model PatrolCheck {
  id       String      @id @default(cuid())
  patrolId String
  content  String
  state    PatrolState @default(GOOD)
  /// 조치사항. 불량일 때 무엇을 했는지 적는다.
  action   String?
  sort     Int         @default(0)

  patrol Patrol @relation(fields: [patrolId], references: [id], onDelete: Cascade)

  @@index([patrolId])
}
